# The sync server at https://{$DOMAIN}/ (what phones and desktops are given)
# and the MCP server at /mcp. Certificates from Let's Encrypt.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	handle /mcp* {
		reverse_proxy anki-mcp:8080
	}
	handle {
		# collections and media can be large
		request_body {
			max_size 512MB
		}
		reverse_proxy anki-sync:8080
	}
}
