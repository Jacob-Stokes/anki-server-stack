# anki-server-stack settings. `./anki-stack install` fills this in; to set up
# without it, fill in the blanks marked "required" and run
# `docker compose up -d`. Never commit .env.

# --- the sync account (required) ---------------------------------------------
# What phones and desktops sign in to the sync server with; the worker uses
# it too. A name or an email address.
ANKI_USER=
# openssl rand -base64 18
ANKI_PASSWORD=

# --- secrets (required; generate with the commands shown) ---------------------
# openssl rand -hex 32 — the key AnkiConnect clients send ("key")
ANKICONNECT_KEY=
# openssl rand -hex 32 — what MCP clients send: Authorization: Bearer <token>
MCP_BEARER_TOKEN=

TZ=UTC

# --- addresses on this machine --------------------------------------------------
# The sync server (give phones this, or the HTTPS address below)
SYNC_BIND=127.0.0.1:8070
# The MCP server (/mcp)
MCP_BIND=127.0.0.1:7012
# The worker's AnkiConnect-compatible API, for other AnkiConnect tools
ANKICONNECT_BIND=127.0.0.1:8765
# Browser origins allowed to call it (comma-separated; e.g. a browser
# extension's origin). Empty: none.
ANKICONNECT_CORS=

# The addresses others use, if any (the installer sets them):
# the sync server (https://anki.example.com) and the MCP server (…/mcp)
PUBLIC_URL=
PUBLIC_MCP_URL=
# The HTTPS port `tailscale serve` uses, when the installer set that up
TS_SERVE_PORT=

# Optional HTTPS: one of caddy, tailscale, cloudflare (sync server at the
# domain's root, the MCP server at /mcp). Add "desktop" for the desktop.
COMPOSE_PROFILES=
# caddy: the domain (pointing at this server) and an email for Let's Encrypt
DOMAIN=
ACME_EMAIL=
# tailscale: an auth key (admin console → Settings → Keys) and a machine name
TS_AUTHKEY=
TS_HOSTNAME=anki
# cloudflare: a tunnel token (Zero Trust → Networks → Tunnels)
CF_TUNNEL_TOKEN=

# --- optional: full Anki in a browser (profile "desktop") -----------------------
# Its web page and login (openssl rand -base64 18)
DESKTOP_BIND=127.0.0.1:3000
DESKTOP_USER=anki
DESKTOP_PASSWORD=
# Run the real AnkiConnect add-on in it too, at DESKTOP_ANKICONNECT_BIND
DESKTOP_ANKICONNECT=false
DESKTOP_ANKICONNECT_BIND=127.0.0.1:8766
# Point the MCP server at the desktop's add-on instead of the worker:
# MCP_ANKI_URL=http://anki-desktop:8765
MCP_ANKI_URL=

# --- optional ----------------------------------------------------------------
# Minutes between the worker's routine syncs (it also syncs after changes)
SYNC_INTERVAL=5
# Largest sync upload the server accepts, in MB (big media collections)
MAX_SYNC_PAYLOAD_MEGS=250
# Run a second copy on the same machine: a prefix for its containers
# (with different *_BIND addresses)
INSTANCE_PREFIX=
