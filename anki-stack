#!/usr/bin/env bash
# anki-stack — set up and manage an anki-server-stack install: Anki's sync
# server, a headless collection behind an AnkiConnect-style API (the worker),
# an MCP server and, optionally, Anki's desktop in a browser, as one compose
# project in this folder. Every command is a thin layer over `docker
# compose`; the install runs without this script once set up (see README.md).
#
# It acts on the install it belongs to: the folder it lives in (following
# symlinks, so a copy linked onto PATH still knows its home), or one given
# with --dir / $ANKI_STACK_DIR.
set -euo pipefail

# --- look and feel -------------------------------------------------------------
#
# One style throughout: "◆ Heading" sections, "✓ / ! / ✗" status lines,
# "? question" prompts, everything else indented two spaces. Long-running
# steps show a spinner with the elapsed time and the step's latest output
# line; image downloads show a progress bar. Colour and animation only on a
# terminal (and not with NO_COLOR); piped or logged output stays plain.

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  TTY=1
  C_ACC=$'\033[38;5;36m' C_B=$'\033[1m' C_DIM=$'\033[2m' C_0=$'\033[0m'
  C_OK=$'\033[38;5;78m' C_WARN=$'\033[38;5;221m' C_ERR=$'\033[38;5;203m'
else
  TTY="" C_ACC="" C_B="" C_DIM="" C_0="" C_OK="" C_WARN="" C_ERR=""
fi
case "$(locale charmap 2>/dev/null)" in UTF-8) SPIN=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏) ;; *) SPIN=('|' '/' '-' '\') ;; esac
[ -n "$TTY" ] && trap 'printf "\033[?25h"' EXIT

say()  { printf '\n%s◆%s %s%s%s\n' "$C_ACC" "$C_0" "$C_B" "$1" "$C_0"; }
ok()   { printf '  %s✓%s %s\n' "$C_OK" "$C_0" "$1"; }
warn() { printf '  %s!%s %s\n' "$C_WARN" "$C_0" "$1"; }
fail() { printf '  %s✗%s %s\n' "$C_ERR" "$C_0" "$1"; }
info() { printf '  %s%s%s\n' "$C_DIM" "$1" "$C_0"; }
die()  { printf '\n  %s✗ %s%s\n' "$C_ERR" "$1" "$C_0" >&2; exit 1; }
# para: an explanation from a heredoc, set off by a blank line
para() { echo; sed "s/^/  /"; }

# Answers given as options (--email, --url, ...), by key;
# see parse_opts. With --yes, a question with no answer given takes its
# default instead of being asked.
declare -A PRESET=()
NONINTERACTIVE=""
JSON=""

# ask "Question" VAR [KEY] — "? Question" (on stderr, like read -p, so it
# never ends up in a $(...) capture); end of input counts as an empty
# answer rather than exiting under set -e. Leading spaces in the question
# are ignored, so every prompt lines up the same. With KEY, an answer given
# as an option is used (and shown) instead of asking.
ask() {
  local q="${1#"${1%%[![:space:]]*}"}" key="${3:-}"
  if [ -n "$key" ] && [ -n "${PRESET[$key]+set}" ]; then
    printf -v "$2" '%s' "${PRESET[$key]}"
    printf '  %s?%s %s%s%s%s\n' "$C_ACC" "$C_0" "$q" "$C_DIM" "${PRESET[$key]}" "$C_0" >&2
    return 0
  fi
  if [ -n "$NONINTERACTIVE" ]; then
    printf -v "$2" '%s' ""
    printf '  %s?%s %s%s(default)%s\n' "$C_ACC" "$C_0" "$q" "$C_DIM" "$C_0" >&2
    return 0
  fi
  anim_on
  read -rp "  ${C_ACC}?${C_0} ${q}" "$2" || printf -v "$2" '%s' ""
  anim_off
}
# ask_secret "Question" VAR [ENV] — hidden input; with ENV, taken from that
# environment variable instead (secrets never go in options, which show up
# in process lists and shell history).
ask_secret() {
  local q="${1#"${1%%[![:space:]]*}"}" env="${3:-}"
  if [ -n "$env" ] && [ -n "${!env+set}" ]; then
    printf -v "$2" '%s' "${!env}"
    printf '  %s?%s %s%s(from $%s)%s\n' "$C_ACC" "$C_0" "$q" "$C_DIM" "$env" "$C_0" >&2
    return 0
  fi
  if [ -n "$NONINTERACTIVE" ]; then
    printf -v "$2" '%s' ""
    return 0
  fi
  anim_on
  read -rsp "  ${C_ACC}?${C_0} ${q}" "$2" || printf -v "$2" '%s' ""
  anim_off
  echo
}
# need KEY "what" — a value that has no default, when not asking
need() { [ -z "$NONINTERACTIVE" ] || [ -n "${PRESET[$1]:-}" ] || die "$2 is needed: --$1 <value>"; }
# interactive_only "what" — a step that can't be done without a person
interactive_only() { [ -z "$NONINTERACTIVE" ] || die "$1"; }

elapsed() { local t="$1"; if [ "$t" -ge 60 ]; then printf '%dm %02ds' $((t / 60)) $((t % 60)); else printf '%ds' "$t"; fi; }

# step "Label" COMMAND... — runs COMMAND with its output in the log, showing
# a spinner, the time so far and the command's latest output line, then
# "✓ Label (12s)". On failure, the last lines of output and the log's path.
step() {
  local label="$1"; shift
  local start=$SECONDS pid rc=0 i=0 last cols room
  mkdir -p "$(dirname "$LOG")"
  printf '\n=== %s  %s\n$ %s\n' "$(date '+%F %T')" "$label" "$*" >> "$LOG"
  if [ -z "$TTY" ]; then
    printf '  … %s\n' "$label"
    "$@" >> "$LOG" 2>&1 </dev/null || rc=$?
  else
    anim_on
    "$@" >> "$LOG" 2>&1 </dev/null &
    pid=$!
    printf '\033[?25l'
    while kill -0 "$pid" 2>/dev/null; do
      cols=$(tput cols 2>/dev/null || echo 80)
      last="$(tail -n 1 "$LOG" 2>/dev/null | tr -d '\r' | sed 's/\x1b\[[0-9;]*[A-Za-z]//g; s/^[[:space:]]*//')"
      room=$(( cols - ${#label} - 16 ))
      [ "$room" -gt 10 ] || last=""
      [ "${#last}" -gt "$room" ] && last="${last:0:$((room - 1))}…"
      printf '\r\033[K  %s%s%s %s  %s%s  %s%s' "$C_ACC" "${SPIN[i++ % ${#SPIN[@]}]}" "$C_0" "$label" \
        "$C_DIM" "$(elapsed $((SECONDS - start)))" "$last" "$C_0"
      sleep 0.12
    done
    wait "$pid" || rc=$?
    anim_off
    printf '\r\033[K\033[?25h'
  fi
  if [ "$rc" -eq 0 ]; then
    ok "$label ${C_DIM}($(elapsed $((SECONDS - start))))${C_0}"
  else
    fail "$label"
    tail -n 12 "$LOG" | sed "s/^/    ${C_DIM}/; s/\$/${C_0}/"
    info "Full log: $LOG"
  fi
  return "$rc"
}
# pull IMAGE "Label" — download an image with a progress bar (percent, MB,
# time), read from Docker's own pull progress. The total comes from the
# image's manifest when the registry provides it, else from the layers as
# they're announced. Falls back to a spinner without the Docker socket.
pull() {
  local image="$1" label="$2" start=$SECONDS total=0 arch rc=0
  docker image inspect "$image" >/dev/null 2>&1 && return 0
  local sock="${DOCKER_HOST:-unix:///var/run/docker.sock}"; sock="${sock#unix://}"
  if [ -z "$TTY" ] || [ ! -S "$sock" ] || [ ! -w "$sock" ]; then
    step "Downloading $label" docker pull "$image"; return
  fi
  case "$(uname -m)" in x86_64) arch=amd64 ;; aarch64|arm64) arch=arm64 ;; *) arch="" ;; esac
  anim_on
  printf '  %s%s%s Downloading %s  %schecking size…%s' "$C_ACC" "${SPIN[0]}" "$C_0" "$label" "$C_DIM" "$C_0"
  if [ -n "$arch" ]; then
    total="$(timeout 20 docker manifest inspect -v "$image" 2>/dev/null | awk -v a="\"architecture\": \"$arch\"" '
      index($0, a) {f=1} f && /"layers"/ {l=1} l && /"size"/ {gsub(/[^0-9]/, ""); s += $0} l && /\]/ {print s+0; exit}')" || total=0
  fi
  printf '\033[?25l'
  local repo="${image%:*}" tag="${image##*:}"
  curl -sN --unix-socket "$sock" -X POST "http://localhost/images/create?fromImage=$repo&tag=$tag" 2>>"$LOG" \
    | tee -a "$LOG" | awk $AWK_LIVE -v total="${total:-0}" -v label="$label" -v acc="$C_ACC" -v dim="$C_DIM" -v reset="$C_0" -v t0="$(date +%s)" '
      function field(name,   m) { if (match($0, "\"" name "\":[0-9]+")) { m = substr($0, RSTART, RLENGTH); sub(/.*:/, "", m); return m + 0 } return -1 }
      function draw(   got, all, pct, n, bar, i, el, phase) {
        got = 0; all = 0
        for (k in tot) { all += tot[k]; got += (k in cur ? cur[k] : 0) }
        if (total > all) all = total
        pct = all > 0 ? int(got * 100 / all) : 0; if (pct > 100) pct = 100
        n = int(pct * 28 / 100); bar = ""
        for (i = 0; i < 28; i++) bar = bar (i < n ? "█" : "░")
        el = systime() - t0; phase = (pct >= 100 || unpacking) ? "unpacking…" : sprintf("%.0f / %.0f MB", got / 1e6, all / 1e6)
        printf "\r\033[K  %s%s%s Downloading %s  %s%s%s %3d%%  %s%s  %d:%02d%s", acc, spin[f++ % 10], reset, label, acc, bar, reset, pct, dim, phase, int(el / 60), el % 60, reset > "/dev/stderr"
        fflush("/dev/stderr")
      }
      BEGIN { split("⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏", spin, " "); f = 0 }
      /"error"/ { err = $0; next }
      {
        id = ""; if (match($0, /"id":"[^"]+"/)) { id = substr($0, RSTART + 6, RLENGTH - 7) }
        c = field("current"); t = field("total")
        if ($0 ~ /"status":"Downloading"/ && t > 0) { tot[id] = t; cur[id] = c }
        else if ($0 ~ /"status":"(Download complete|Pull complete|Already exists)"/ && id in tot) { cur[id] = tot[id] }
        else if ($0 ~ /"status":"Extracting"/) { unpacking = 1 }
        if (++lines % 5 == 0) draw()
      }
      END { draw(); printf "\r\033[K" > "/dev/stderr"; fflush("/dev/stderr"); if (err != "") { print err > "/dev/stderr"; exit 1 } }' || rc=$?
  anim_off
  printf '\033[?25h'
  if [ "$rc" -eq 0 ] && docker image inspect "$image" >/dev/null 2>&1; then
    ok "Downloaded $label ${C_DIM}($(awk -v b="${total:-0}" 'BEGIN { if (b > 0) printf "%.1f GB, ", b / 1e9 }')$(elapsed $((SECONDS - start))))${C_0}"
  else
    fail "Couldn't download $label ($image)"; info "Details in $LOG"; return 1
  fi
}

# mawk reads piped input in large blocks unless told not to, which would hold
# the progress bar back until the download had finished.
AWK_LIVE=""; awk -W version 2>/dev/null | grep -qi mawk && AWK_LIVE="-W interactive"

# The banner: a card with Anki's star, drawn in box characters
BANNER_SHOWN=""
anim_on() { :; }; anim_off() { :; }; anim_stop() { :; }
banner() {
  BANNER_SHOWN=1
  [ -n "$TTY" ] || { printf '\nanki-server-stack\n'; return; }
  local b=$'\033[38;5;33m' s=$'\033[38;5;220m' o="$C_0"
  printf '\n'
  printf '  %s╭───────────╮%s\n' "$b" "$o"
  printf '  %s│%s     %s★%s     %s│%s   %sanki-server-stack%s\n' "$b" "$o" "$s" "$o" "$b" "$o" "$C_B" "$o"
  printf '  %s│%s    %s★★★%s    %s│%s   %sAnki sync, a headless collection and an MCP server,%s\n' "$b" "$o" "$s" "$o" "$b" "$o" "$C_DIM" "$o"
  printf '  %s│%s     %s★%s     %s│%s   %sin one Docker Compose project%s\n' "$b" "$o" "$s" "$o" "$b" "$o" "$C_DIM" "$o"
  printf '  %s╰───────────╯%s\n' "$b" "$o"
}

usage() {
  cat <<'USAGE'
Usage: anki-stack [--dir PATH] <command> [options]

  install             set up (or repair) this install: asks a few questions,
                      writes .env, then docker compose up -d
  address             change how it's reached (HTTPS, Tailscale, a proxy…)
  status              containers, sync, the worker's collection, the MCP server
  logs [SERVICE] [-f] recent logs (sync, worker, mcp, desktop, caddy, …)
  restart [SERVICE]   restart one service, or everything
  endpoint [--show-token]
                      the MCP server's address and bearer token, and the
                      AnkiConnect address and key
  sync [--download|--upload]
                      sync the worker now; --download replaces its copy with
                      the server's, --upload the server's with its copy
  users [list|add NAME|passwd NAME|remove NAME]
                      sync accounts: more people, or a new password
  desktop [on|off|ankiconnect on|off]
                      full Anki in a browser (optional), and AnkiConnect in it
  backup [FILE]       the sync server's collections and .env, in one archive
  restore FILE        put a backup back (replaces the current collections)
  update              git pull, then rebuild and restart on the new version
  uninstall [--yes]   stop and remove the containers; data is kept unless asked
  link [NAME]         put this command on PATH (/usr/local/bin)

Without questions (for scripts): install --yes with --user NAME,
--password-env VAR, --tz, --desktop yes|no, --desktop-ankiconnect yes|no,
--https none|caddy|tailscale|cloudflare (run by the stack) or
host-tailscale|host-cloudflare|proxy (already on this machine), --domain,
--url, --acme-email, --tailscale-serve yes|no, --tailnet-extras yes|no;
secrets (TS_AUTHKEY, CF_TUNNEL_TOKEN) from the environment.
USAGE
}

# --- which install ---------------------------------------------------------------

DIR=""
if [ "${1:-}" = "--dir" ]; then DIR="${2:?--dir needs a path}"; shift 2; fi
DIR="${DIR:-${ANKI_STACK_DIR:-}}"
[ -n "$DIR" ] || DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
[ -f "$DIR/compose.yml" ] && [ -f "$DIR/app/ankistack/worker.py" ] || die "$DIR is not an anki-server-stack folder (use --dir)"
cd "$DIR"
ROOT="$(pwd)"
mkdir -p data
LOG="$ROOT/data/anki-stack.log"
ME="$0"
[ "$(command -v "$(basename "$0")" 2>/dev/null)" = "$0" ] && ME="$(basename "$0")"
P=""

# .env read as data, the way Compose reads it (KEY=value, quotes optional),
# never run as a script: a value with a space or a $ in it is just a value
load_env() {
  local line k v
  if [ -f .env ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
      k="${BASH_REMATCH[1]}"; v="${BASH_REMATCH[2]}"
      if [[ "$v" =~ ^\"(.*)\"[[:space:]]*$ ]] || [[ "$v" =~ ^\'(.*)\'[[:space:]]*$ ]]; then v="${BASH_REMATCH[1]}"; fi
      export "$k=$v"
    done < .env
  fi
  P="${INSTANCE_PREFIX:-}"
}

# set_env FILE KEY VALUE [force] — replaces KEY= in FILE, only if currently
# empty unless "force"
set_env() {
  local file="$1" key="$2" val="$3" force="${4:-}"
  touch "$file"
  if grep -q "^${key}=" "$file"; then
    if [ -n "$force" ] || [ -z "$(grep "^${key}=" "$file" | cut -d= -f2- | tr -d '"')" ]; then
      local tmp; tmp="$(mktemp)"
      K="$key" V="\"$val\"" awk 'index($0, ENVIRON["K"]"=")==1 { print ENVIRON["K"]"="ENVIRON["V"]; next } { print }' "$file" > "$tmp"
      cat "$tmp" > "$file" && rm -f "$tmp"
    fi
  else
    echo "${key}=\"${val}\"" >> "$file"
  fi
}
# (set_env changes the file; callers run load_env before docker compose,
# which takes exported variables over .env)
env_get() { grep "^$1=" .env 2>/dev/null | tail -1 | cut -d= -f2- | sed 's/^"//; s/"$//'; }

dc() { docker compose "$@"; }
require_installed() {
  load_env
  [ -n "${ANKICONNECT_KEY:-}" ] && docker container inspect "${P}anki-sync" >/dev/null 2>&1 || die "this install isn't set up yet — run: $ME install"
}
kv() { printf '    %s%-16s%s %s\n' "$C_DIM" "$1" "$C_0" "$2"; }
until_ok() { local n="$1"; shift; for _ in $(seq 1 "$n"); do "$@" >/dev/null 2>&1 && return 0; sleep 2; done; return 1; }
# host:port → a URL on this machine
local_url() { local b="$1"; b="${b/0.0.0.0/127.0.0.1}"; [[ "$b" == *:* ]] || b="127.0.0.1:$b"; echo "http://$b"; }
sync_url() { local_url "${SYNC_BIND:-127.0.0.1:8070}"; }
mcp_url() { local_url "${MCP_BIND:-127.0.0.1:7012}"; }
ac_url() { local_url "${ANKICONNECT_BIND:-127.0.0.1:8765}"; }
has_profile() { [[ ",${COMPOSE_PROFILES:-}," == *",$1,"* ]]; }
# set_profile NAME on|off — COMPOSE_PROFILES is a comma-separated list
set_profile() {
  local cur new p; cur="$(env_get COMPOSE_PROFILES)"; new=""
  for p in ${cur//,/ }; do [ "$p" = "$1" ] || new="${new:+$new,}$p"; done
  [ "$2" = on ] && new="${new:+$new,}$1"
  set_env .env COMPOSE_PROFILES "$new" force; export COMPOSE_PROFILES="$new"
}
worker_health() { curl -sf "$(ac_url)/health"; }
own_data() { mkdir -p data/sync data/worker "$@"; chown 1000:1000 data/sync data/worker "$@" 2>/dev/null || true; }

# --- install -----------------------------------------------------------------------

guess_tz() {
  local tz=""
  tz="$(timedatectl show -p Timezone --value 2>/dev/null || true)"
  [ -n "$tz" ] || tz="$(cat /etc/timezone 2>/dev/null || true)"
  [ -n "$tz" ] || tz="$(readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||')"
  echo "${tz:-UTC}"
}

# --- what's already on this machine ---------------------------------------------
# So the address step can offer to use it, rather than run a second one.

# what listens on ports 80/443 (a process name, or "something"), if not ours
ports_web_taken() {
  local who
  docker container inspect "${P}anki-caddy" >/dev/null 2>&1 && [ "$(docker inspect -f '{{.State.Running}}' "${P}anki-caddy")" = true ] && return 1
  who="$(ss -ltnpH '( sport = :80 or sport = :443 )' 2>/dev/null | sed -n 's/.*users:(("\([^"]*\)".*/\1/p' | sort -u | paste -sd, -)"
  [ -n "$who" ] || who="$(ss -ltnH '( sport = :80 or sport = :443 )' 2>/dev/null | head -1 | grep -q . && echo something)"
  [ -n "$who" ] && echo "$who"
}
# this machine's Tailscale: "IP NAME" (NAME is <machine>.<tailnet>.ts.net)
host_tailscale() {
  command -v tailscale >/dev/null 2>&1 || return 1
  local ip name
  ip="$(tailscale ip -4 2>/dev/null | head -1)"; [ -n "$ip" ] || return 1
  name="$(tailscale status --json 2>/dev/null | sed -n 's/.*"DNSName": *"\([^"]*\)\.".*/\1/p' | head -1)"
  echo "$ip ${name:-}"
}
# a cloudflared already running here (a service or a container), not ours
host_cloudflared() {
  pgrep -x cloudflared >/dev/null 2>&1 && ! docker container inspect "${P}anki-cloudflared" >/dev/null 2>&1 && return 0
  docker ps --format '{{.Image}} {{.Names}}' 2>/dev/null | grep -v " ${P}anki-cloudflared$" | grep -q '^cloudflare/cloudflared'
}
# the first HTTPS port `tailscale serve` isn't using: 443, else 10443 upwards
free_serve_port() {
  local used p; used="$(tailscale serve status --json 2>/dev/null | grep -oE '"[0-9]+": *\{' | grep -oE '[0-9]+')"
  for p in 443 $(seq 10443 10499); do grep -qx "$p" <<<"$used" || { echo "$p"; return; }; done
}
# set_bind VAR HOST — keep the port, change the address it listens on
set_bind() { local cur; cur="$(env_get "$1")"; cur="${cur:-$2:0}"; set_env .env "$1" "$2:${cur##*:}" force; }
port_of() { local v; v="$(env_get "$1")"; echo "${v##*:}"; }

# The snippets for a proxy already running here, written to data/ and shown
proxy_snippet() {
  local kind="$1" host="$2" sp mp f=data/proxy-example.txt; sp="$(port_of SYNC_BIND)"; mp="$(port_of MCP_BIND)"
  case "$kind" in
    *caddy*) cat > "$f" <<EOF
# Caddyfile: the sync server at the root, the MCP server at /mcp
$host {
	handle /mcp* {
		reverse_proxy 127.0.0.1:$mp
	}
	handle {
		reverse_proxy 127.0.0.1:$sp
	}
}
EOF
    ;;
    *nginx*) cat > "$f" <<EOF
# nginx: the sync server at the root, the MCP server at /mcp
server {
    server_name $host;
    client_max_body_size 512M;   # whole-collection uploads
    location /mcp {
        proxy_pass http://127.0.0.1:$mp;
        proxy_http_version 1.1;
        proxy_buffering off;     # streamed MCP responses
    }
    location / {
        proxy_pass http://127.0.0.1:$sp;
    }
    # plus your usual listen 443 ssl; and certificate lines
}
EOF
    ;;
    cloudflared) cat > "$f" <<EOF
# cloudflared (config.yml ingress, above the catch-all rule), or the same two
# public hostname routes in the Cloudflare dashboard:
  - hostname: $host
    path: ^/mcp
    service: http://localhost:$mp
  - hostname: $host
    service: http://localhost:$sp
EOF
    ;;
    *) cat > "$f" <<EOF
# Any reverse proxy: for $host,
#   /mcp (and below)  →  http://127.0.0.1:$mp   (no response buffering)
#   everything else   →  http://127.0.0.1:$sp   (allow large request bodies)
EOF
    ;;
  esac
  sed 's/^/    /' "$f"; info "(saved in $f)"
  info "If the proxy runs in a container, 127.0.0.1 is the container itself: point it at an address of"
  info "this machine it can reach, and set SYNC_BIND / MCP_BIND in .env to listen there."
}

choose_https() {
  local choice def=1 web ts ts_ip ts_name cf
  web="$(ports_web_taken || true)"; ts="$(host_tailscale || true)"; ts_ip="${ts%% *}"; ts_name="${ts#* }"; [ "$ts_name" = "$ts" ] && ts_name=""
  cf=""; host_cloudflared && cf=1
  say "Address"
  info "Phones and desktops sync with the sync server; give them its address."
  local found=""
  [ -n "$web" ] && found+="  ${C_WARN}•${C_0} ports 80/443 are in use (${web}): a web server or proxy is already running"$'\n'
  [ -n "$ts" ] && found+="  ${C_OK}•${C_0} this machine is on Tailscale (${ts_name:-$ts_ip})"$'\n'
  [ -n "$cf" ] && found+="  ${C_OK}•${C_0} cloudflared is already running here"$'\n'
  [ -n "$found" ] && { echo; info "Found on this machine:"; printf '%s' "$found"; }
  if [ -n "$web" ]; then def=7; elif [ -n "$ts" ]; then def=5; elif [ -n "$cf" ]; then def=6; fi
  local x2="" x5="" x6="" x7=""
  [ -n "$web" ] && x2=" ${C_WARN}(80/443 taken)${C_0}"
  [ -n "$ts" ] && x5=" ${C_OK}(found)${C_0}"
  [ -n "$cf" ] && x6=" ${C_OK}(found)${C_0}"
  [ -n "$web" ] && x7=" ${C_OK}(found: $web)${C_0}"
  cat <<EOM

  ${C_DIM}New, run by this stack${C_0}
  ${C_ACC}1${C_0}  ${C_B}This machine only${C_0}             $(sync_url) (elsewhere: an SSH tunnel)
  ${C_ACC}2${C_0}  ${C_B}A domain, with HTTPS${C_0}          its own Caddy and Let's Encrypt; needs ports 80/443${x2}
  ${C_ACC}3${C_0}  ${C_B}Tailscale, as its own machine${C_0} https://<name>.<tailnet>.ts.net, private to a tailnet
  ${C_ACC}4${C_0}  ${C_B}A Cloudflare Tunnel${C_0}           its own tunnel; a domain on Cloudflare, no open ports
  ${C_DIM}Already on this machine${C_0}
  ${C_ACC}5${C_0}  ${C_B}This machine's Tailscale${C_0}      no extra container${x5}
  ${C_ACC}6${C_0}  ${C_B}Its Cloudflare Tunnel${C_0}         add two routes to the tunnel you have${x6}
  ${C_ACC}7${C_0}  ${C_B}Its reverse proxy${C_0}             Caddy, nginx, Traefik…: forward a domain here${x7}

EOM
  ask "Choice [$def]: " choice https
  choice="${choice:-$def}"
  for p in caddy tailscale cloudflare; do set_profile "$p" off; done
  set_env .env PUBLIC_MCP_URL "" force
  case "$choice" in
    1|none) set_env .env PUBLIC_URL "" force ;;
    2|caddy)
      if [ -n "$web" ]; then
        warn "Ports 80/443 are in use ($web); the stack's Caddy couldn't start. Option 7 uses what's there."
        [ -z "$NONINTERACTIVE" ] || die "ports 80/443 are in use ($web): use --https proxy (or free them)"
        local go; ask "Use Caddy anyway? [y/N] " go; case "$go" in [yY]*) ;; *) choose_https; return ;; esac
      fi
      local d e; need domain "the domain"; ask "Domain (e.g. anki.example.com): " d domain; [ -n "$d" ] || die "a domain is needed"
      ask "Email for Let's Encrypt (renewal notices): " e acme-email
      set_profile caddy on; set_env .env DOMAIN "$d" force; set_env .env ACME_EMAIL "$e" force
      set_env .env PUBLIC_URL "https://$d" force; set_env .env PUBLIC_MCP_URL "https://$d/mcp" force ;;
    3|tailscale)
      local k h; ask_secret "Tailscale auth key (hidden; admin console → Settings → Keys): " k TS_AUTHKEY
      [ -n "$k" ] || die "an auth key is needed (TS_AUTHKEY)"
      ask "Machine name on the tailnet [anki]: " h ts-hostname
      set_profile tailscale on; set_env .env TS_AUTHKEY "$k" force; set_env .env TS_HOSTNAME "${h:-anki}" force ;;
    5|host-tailscale)
      [ -n "$ts" ] || die "Tailscale isn't running on this machine (tailscale ip -4 gives nothing)"
      choose_host_tailscale "$ts_ip" "$ts_name" ;;
    4|cloudflare)
      local t d; ask_secret "Tunnel token (hidden; Zero Trust → Networks → Tunnels): " t CF_TUNNEL_TOKEN
      [ -n "$t" ] || die "a tunnel token is needed (CF_TUNNEL_TOKEN)"
      need domain "the domain"; ask "Its public hostname (e.g. anki.example.com): " d domain
      set_profile cloudflare on; set_env .env CF_TUNNEL_TOKEN "$t" force; set_env .env DOMAIN "$d" force
      set_env .env PUBLIC_URL "https://$d" force; set_env .env PUBLIC_MCP_URL "https://$d/mcp" force
      info "In Cloudflare, route $d to http://anki-sync:8080, and $d/mcp to http://anki-mcp:8080." ;;
    6|host-cloudflare)
      local d; need domain "the hostname"; ask "Hostname to use (e.g. anki.example.com): " d domain; [ -n "$d" ] || die "a hostname is needed"
      set_env .env PUBLIC_URL "https://$d" force; set_env .env PUBLIC_MCP_URL "https://$d/mcp" force
      echo; info "Add these routes to your tunnel, then restart cloudflared:"; proxy_snippet cloudflared "$d" ;;
    7|proxy)
      local u kind; need url "the public URL"; ask "Public URL (e.g. https://anki.example.com): " u url
      [[ "$u" == http*://* ]] || die "the URL should start with https:// (or http://)"
      set_env .env PUBLIC_URL "${u%/}" force; set_env .env PUBLIC_MCP_URL "${u%/}/mcp" force
      kind="${web:-generic}"; echo; info "For your proxy ($kind):"; proxy_snippet "$kind" "$(sed -E 's|^https?://||; s|/.*||' <<<"$u")" ;;
    *) die "not a choice: $choice" ;;
  esac
}

# Option 4: this machine's own Tailscale. Either `tailscale serve` gives
# HTTPS at https://<machine>.<tailnet>.ts.net[:port] (the stack stays on
# 127.0.0.1), or the stack listens on the Tailscale address itself (plain HTTP
# inside the tailnet, which WireGuard already encrypts).
choose_host_tailscale() {
  local ip="$1" name="$2" ans port
  if [ -n "$name" ]; then
    para <<'EOM'
`tailscale serve` can give it an HTTPS address on the tailnet, with a
certificate; some apps (and phones) insist on HTTPS.
EOM
    ask "Serve it over HTTPS with tailscale serve? [Y/n] " ans tailscale-serve
  else ans=n; fi
  case "$ans" in
    [nN]*)
      set_bind SYNC_BIND "$ip"; set_bind MCP_BIND "$ip"
      set_env .env PUBLIC_URL "http://$ip:$(port_of SYNC_BIND)" force
      set_env .env PUBLIC_MCP_URL "http://$ip:$(port_of MCP_BIND)/mcp" force ;;
    *)
      port="$(free_serve_port)"; [ -n "$port" ] || die "no free HTTPS port for tailscale serve"
      [ "$port" = 443 ] || info "tailscale serve already uses 443 here; using port $port."
      tailscale serve --bg --yes --https="$port" "http://127.0.0.1:$(port_of SYNC_BIND)" >>"$LOG" 2>&1 \
        && tailscale serve --bg --yes --https="$port" --set-path=/mcp "http://127.0.0.1:$(port_of MCP_BIND)/mcp" >>"$LOG" 2>&1 \
        || die "tailscale serve failed (see $LOG); as root, with Tailscale's HTTPS certificates enabled for the tailnet"
      local base="https://$name"; [ "$port" = 443 ] || base="$base:$port"
      set_env .env PUBLIC_URL "$base" force; set_env .env PUBLIC_MCP_URL "$base/mcp" force
      set_env .env TS_SERVE_PORT "$port" force
      ok "tailscale serve: $base (the sync server) and $base/mcp" ;;
  esac
  # the desktop and the AnkiConnect API, if used, are also most useful on the tailnet
  ask "Also make the desktop and the AnkiConnect API reachable on the tailnet ($ip)? [Y/n] " ans tailnet-extras
  case "$ans" in [nN]*) ;; *) set_bind ANKICONNECT_BIND "$ip"; set_bind DESKTOP_BIND "$ip" ;; esac
}

choose_desktop() {
  local ans ac
  say "Desktop ${C_DIM}(optional)${C_0}"
  para <<'EOM'
Full Anki in a browser tab, already signed in to this sync server: for
reviewing, the card browser, add-ons and editing note types. It's a 2–3 GB
download and uses ~350 MB of memory while running. Without it, phones and
your own desktop Anki sync with the server as usual.
EOM
  ask "Add the desktop? [y/N] " ans desktop
  case "$ans" in
    [yY]*)
      set_profile desktop on
      [ -n "$(env_get DESKTOP_PASSWORD)" ] || set_env .env DESKTOP_PASSWORD "$(openssl rand -base64 18 | tr -d '/+=' | cut -c1-20)" force
      para <<'EOM'
The real AnkiConnect add-on can run in it too, for tools that need actions
the built-in API doesn't have (it covers decks, notes, cards, tags and media).
EOM
      ask "Run AnkiConnect in the desktop? [y/N] " ac desktop-ankiconnect
      case "$ac" in [yY]*) set_env .env DESKTOP_ANKICONNECT true force ;; *) set_env .env DESKTOP_ANKICONNECT false force ;; esac ;;
    *) set_profile desktop off ;;
  esac
}

cmd_install() {
  command -v docker >/dev/null 2>&1 || die "docker is not installed. See https://docs.docker.com/engine/install/"
  local cv; cv="$(docker compose version --short 2>/dev/null | sed 's/^v//')" || die "docker compose (v2 plugin) is required"
  printf '%s\n2.24.0\n' "$cv" | sort -V -C 2>/dev/null && [ "$cv" != 2.24.0 ] && die "docker compose $cv is too old; 2.24 or newer is needed"
  command -v openssl >/dev/null 2>&1 || die "openssl is required to generate secrets"
  command -v curl >/dev/null 2>&1 || die "curl is required"

  banner
  info "$ROOT"
  say "Configuration"
  if [ ! -f .env ]; then cp .env.example .env; ok "Created .env"; else ok "Using the existing .env"; fi
  chmod 600 .env
  load_env
  [ -n "${ANKICONNECT_KEY:-}" ] || { set_env .env ANKICONNECT_KEY "$(openssl rand -hex 32)"; ok "Generated the AnkiConnect key"; }
  [ -n "${MCP_BEARER_TOKEN:-}" ] || { set_env .env MCP_BEARER_TOKEN "$(openssl rand -hex 32)"; ok "Generated the MCP bearer token"; }

  local fresh="" generated="" user pw tz cur
  local v; for v in TS_AUTHKEY CF_TUNNEL_TOKEN; do [ -n "${!v:-}" ] || unset "$v"; done
  [ -n "$(ls -A data/sync 2>/dev/null)" ] || fresh=1
  if [ -n "$fresh" ] || [ -z "$(env_get ANKI_USER)" ]; then
    say "Sync account"
    info "Phones, desktops and this stack sign in to the sync server with it."
    user="$(env_get ANKI_USER)"
    if [ -z "$user" ]; then need user "the account name"; ask "Account name (a name or an email): " user user; fi
    [[ "$user" =~ ^[^:[:space:]]+$ ]] || die "the account name can't be empty or contain spaces or ':'"
    pw="$(env_get ANKI_PASSWORD)"
    [ -n "$pw" ] || pw="$PRESET_PASSWORD"
    if [ -z "$pw" ]; then
      ask_secret "Password (hidden, 8+ characters; blank to generate one): " pw ANKI_PASSWORD
      if [ -z "$pw" ]; then pw="$(openssl rand -base64 18 | tr -d '/+=' | cut -c1-16)"; generated=1; fi
    fi
    [ "${#pw}" -ge 8 ] || die "the password needs 8 or more characters"
    [[ "$pw" != *:* ]] || die "the password can't contain ':'"
    tz="$(guess_tz)"; ask "Timezone [$tz]: " cur tz; tz="${cur:-$tz}"
    set_env .env ANKI_USER "$user" force; set_env .env ANKI_PASSWORD "$pw" force; set_env .env TZ "$tz" force
    choose_https
    choose_desktop
  fi
  load_env

  say "Starting"
  own_data; has_profile desktop && own_data data/desktop
  local img
  for img in $(awk '/^ *image: / && !/anki-stack/ {print $2}' compose.yml | sort -u); do
    case "$img" in caddy*) has_profile caddy || continue ;; tailscale/*) has_profile tailscale || continue ;; cloudflare/*) has_profile cloudflare || continue ;; esac
    pull "$img" "$img"
  done
  step "Building the Anki image (sync server, worker, MCP)" dc --progress plain build anki-sync || die "the build failed (see above)"
  if has_profile desktop; then step "Building the desktop image (takes a few minutes)" dc --progress plain build anki-desktop || die "the desktop build failed"; fi
  step "Starting" dc --progress plain up -d --remove-orphans || die "it didn't start; see: $ME logs"
  step "Waiting for the worker's first sync" until_ok 60 worker_health || warn "the worker isn't answering yet: $ME logs worker"
  step "Waiting for the MCP server" until_ok 30 curl -sf "$(mcp_url)/health" || warn "the MCP server isn't answering yet: $ME logs mcp"
  has_profile tailscale && tailscale_url

  [ -t 0 ] && [ -z "$NONINTERACTIVE" ] && offer_link
  say "Ready"
  load_env
  kv "Sync server" "$(sync_url)${PUBLIC_URL:+  ·  ${PUBLIC_URL}}"
  kv "Account" "${ANKI_USER}"
  [ -n "$generated" ] && kv "Password" "${C_B}${pw}${C_0} ${C_DIM}(in .env as ANKI_PASSWORD)${C_0}"
  kv "MCP server" "$(mcp_url)/mcp${PUBLIC_MCP_URL:+  ·  ${PUBLIC_MCP_URL}}"
  kv "Bearer token" "${MCP_BEARER_TOKEN:0:6}… ${C_DIM}(full: $ME endpoint --show-token)${C_0}"
  kv "AnkiConnect" "$(ac_url) ${C_DIM}(key: $ME endpoint --show-token)${C_0}"
  if has_profile desktop; then kv "Desktop" "$(local_url "${DESKTOP_BIND:-127.0.0.1:3000}")  ${C_DIM}login ${DESKTOP_USER:-anki} / ${DESKTOP_PASSWORD}${C_0}"; fi
  info ""
  info "Phones: AnkiDroid → Settings → Sync → Custom sync server; AnkiMobile → Settings → Syncing → Custom server."
  kv "Manage" "$ME status · sync · backup · help"
}

# Tailscale names the machine <name>.<tailnet>.ts.net; it's known once joined
tailscale_url() {
  local dom=""
  for _ in $(seq 1 30); do
    dom="$(docker exec "${P}anki-tailscale" tailscale status --json 2>/dev/null | sed -n 's/.*"CertDomains": *\["\([^"]*\)".*/\1/p' | head -1)"
    [ -n "$dom" ] && break; sleep 2
  done
  [ -n "$dom" ] || { warn "Tailscale hasn't joined the tailnet yet; its address will be https://<name>.<tailnet>.ts.net"; return; }
  set_env .env PUBLIC_URL "https://$dom" force; set_env .env PUBLIC_MCP_URL "https://$dom/mcp" force
  ok "Tailscale address: https://$dom"
}

offer_link() {
  local name ans; name="anki-stack${P:+-${P%-}}"
  [ "$(readlink -f "/usr/local/bin/$name" 2>/dev/null)" = "$ROOT/anki-stack" ] && return 0
  echo; ask "Add an '$name' command (/usr/local/bin) to manage this install? [Y/n] " ans
  case "$ans" in [nN]*) ;; *) cmd_link "$name" && ME="$name" ;; esac
}

cmd_link() {
  local name="${1:-anki-stack${P:+-${P%-}}}"
  ln -sfn "$ROOT/anki-stack" "/usr/local/bin/$name" 2>/dev/null && ok "Added the '$name' command" || warn "couldn't write /usr/local/bin/$name (not root?)"
}

# anki-stack address: change how the stack is reached, after installing
cmd_address() {
  [ -f .env ] || die "no .env yet — run: $ME install"
  load_env
  local old_port="${TS_SERVE_PORT:-}"
  choose_https
  load_env
  # a tailscale serve route this stack set up and no longer uses
  if [ -n "$old_port" ] && [ "${TS_SERVE_PORT:-}" = "$old_port" ] && [[ "${PUBLIC_URL:-}" != https://*.ts.net* ]]; then
    tailscale serve --https="$old_port" off >>"$LOG" 2>&1 && ok "Removed the tailscale serve route on port $old_port"
    set_env .env TS_SERVE_PORT "" force
  fi
  if docker container inspect "${P}anki-sync" >/dev/null 2>&1; then
    step "Applying" dc --progress plain up -d --remove-orphans || die "it didn't start: $ME logs"
    has_profile tailscale && tailscale_url
  fi
  say "Address"
  kv "Sync server" "$(sync_url)${PUBLIC_URL:+  ·  ${PUBLIC_URL}}"
  kv "MCP server" "$(mcp_url)/mcp${PUBLIC_MCP_URL:+  ·  ${PUBLIC_MCP_URL}}"
}

# --- day to day ----------------------------------------------------------------------

svc() {
  case "$1" in
    sync|server|anki-sync) echo anki-sync ;; worker|api|anki-worker) echo anki-worker ;; mcp|anki-mcp) echo anki-mcp ;;
    desktop|anki-desktop) echo anki-desktop ;; caddy|tailscale|cloudflared) echo "$1" ;;
    "") echo "" ;; *) die "no service '$1' (sync, worker, mcp, desktop, caddy, tailscale, cloudflared)" ;;
  esac
}

cmd_status() {
  require_installed
  say "anki-server-stack"
  kv "Folder" "$ROOT${P:+  ·  prefix $P}"
  kv "Sync server" "$(sync_url)${PUBLIC_URL:+  ·  ${PUBLIC_URL}}"
  local h
  if curl -sf "$(mcp_url)/health" >/dev/null 2>&1; then h="${C_OK}● responding${C_0}"; else h="${C_ERR}● not responding${C_0}"; fi
  kv "MCP server" "$(mcp_url)/mcp  $h"
  say "Containers"
  dc ps -a --format '{{.Service}}\t{{.Status}}' | while IFS=$'\t' read -r s st; do
    local dot="${C_OK}●${C_0}"
    case "$st" in Exited*|Restarting*) dot="${C_ERR}●${C_0}" ;; *unhealthy*|*starting*) dot="${C_WARN}●${C_0}" ;; esac
    printf '  %s %-14s %s%s%s\n' "$dot" "$s" "$C_DIM" "$st" "$C_0"
  done
  say "Worker's collection"
  local j; j="$(worker_health 2>/dev/null)" || { fail "the worker isn't answering: $ME logs worker"; return; }
  local notes last res err
  notes="$(sed -n 's/.*"notes": \([0-9]*\).*/\1/p' <<<"$j")"
  last="$(sed -n 's/.*"last_sync": "\([^"]*\)".*/\1/p' <<<"$j")"
  res="$(sed -n 's/.*"last_result": "\([^"]*\)".*/\1/p' <<<"$j")"
  err="$(sed -n 's/.*"last_error": "\([^"]*\)".*/\1/p' <<<"$j")"
  kv "Notes" "${notes:-?} ${C_DIM}(account ${ANKI_USER})${C_0}"
  kv "Last sync" "${last:-never}${res:+  ${C_DIM}${res}${C_0}}"
  if [ -n "$err" ]; then fail "Last sync failed: $err"; else ok "Syncing"; fi
}

cmd_logs() {
  require_installed
  local s="" follow=""
  for a in "$@"; do case "$a" in -f) follow=-f ;; *) s="$(svc "$a")" ;; esac; done
  dc logs --tail "${PRESET[tail]:-100}" $follow $s
}

cmd_restart() {
  require_installed
  local s; s="$(svc "${1:-}")"
  if [ -z "$s" ]; then step "Restarting everything" dc --progress plain up -d --force-recreate; else step "Restarting $s" dc restart "$s"; fi
}

cmd_endpoint() {
  require_installed
  local show=""; { [ "${1:-}" = "--show-token" ] || [ -n "${PRESET[show-token]:-}" ]; } && show=1
  say "MCP server"
  kv "On this machine" "$(mcp_url)/mcp"
  [ -n "${PUBLIC_MCP_URL:-}" ] && kv "Public" "${PUBLIC_MCP_URL}"
  if [ -n "$show" ]; then kv "Bearer token" "$MCP_BEARER_TOKEN"; else kv "Bearer token" "${MCP_BEARER_TOKEN:0:6}… ${C_DIM}(--show-token to print it)${C_0}"; fi
  info 'Clients send it as: Authorization: Bearer <token>'
  say "AnkiConnect"
  kv "Built-in API" "$(ac_url)"
  if has_profile desktop && [ "${DESKTOP_ANKICONNECT:-false}" = true ]; then kv "Desktop add-on" "$(local_url "${DESKTOP_ANKICONNECT_BIND:-127.0.0.1:8766}")"; fi
  if [ -n "$show" ]; then kv "Key" "$ANKICONNECT_KEY"; else kv "Key" "${ANKICONNECT_KEY:0:6}… ${C_DIM}(--show-token to print it)${C_0}"; fi
  info 'Clients send it as "key" in each request'
}

cmd_sync() {
  require_installed
  local force="" body out
  case "${1:-}" in --download) force=download ;; --upload) force=upload ;; "") ;; *) die "usage: $ME sync [--download|--upload]" ;; esac
  if [ -n "$force" ]; then
    local ans
    if [ "$force" = upload ]; then info "Replaces the server's collection with the worker's copy; every device then downloads it."
    else info "Replaces the worker's copy with the server's (changes only the worker has are lost)."; fi
    ask "Go ahead? [y/N] " ans confirm
    case "$ans" in [yY]*) ;; *) info "Nothing changed."; return ;; esac
  fi
  body="{\"key\":\"$ANKICONNECT_KEY\"${force:+,\"force\":\"$force\"}}"
  out="$(curl -s -m 600 -X POST "$(ac_url)/admin/sync" -H 'Content-Type: application/json' -d "$body")" || die "the worker didn't answer: $ME logs worker"
  case "$out" in *'"result"'*) ok "$(sed -n 's/.*"result": "\([^"]*\)".*"notes": \([0-9]*\).*/\1 (\2 notes)/p' <<<"$out")" ;; *) die "sync failed: $out" ;; esac
}

# --- sync accounts (SYNC_USER1 is ANKI_USER in .env; more in users.env) ------

users_list() { grep -E '^SYNC_USER[0-9]+=' users.env 2>/dev/null | cut -d= -f2- | sed 's/^"//; s/"$//' | cut -d: -f1; }
cmd_users() {
  require_installed
  local sub="${1:-list}" name="${2:-}" pw line n
  case "$sub" in
    list)
      say "Sync accounts"
      printf '  %s %s\n' "${ANKI_USER}" "${C_DIM}(the stack's own: the worker and desktop use it)${C_0}"
      users_list | while read -r u; do printf '  %s\n' "$u"; done ;;
    add|passwd)
      [ -n "$name" ] || die "usage: $ME users $sub NAME"
      [[ "$name" =~ ^[^:[:space:]]+$ ]] || die "a name can't contain spaces or ':'"
      if [ "$sub" = add ] && { [ "$name" = "$ANKI_USER" ] || users_list | grep -qx "$name"; }; then die "$name already exists (new password: $ME users passwd $name)"; fi
      if [ "$sub" = passwd ] && [ "$name" != "$ANKI_USER" ] && ! users_list | grep -qx "$name"; then die "no account $name"; fi
      ask_secret "Password for $name (hidden, 8+ characters; blank to generate one): " pw ANKI_NEW_PASSWORD
      local gen=""; [ -n "$pw" ] || { pw="$(openssl rand -base64 18 | tr -d '/+=' | cut -c1-16)"; gen=1; }
      [ "${#pw}" -ge 8 ] && [[ "$pw" != *:* ]] || die "the password needs 8+ characters and no ':'"
      if [ "$name" = "$ANKI_USER" ]; then
        set_env .env ANKI_PASSWORD "$pw" force
        load_env   # compose prefers the environment to .env: this one has the old password
        step "Restarting with the new password" dc --progress plain up -d --force-recreate anki-sync anki-worker || die "couldn't restart: $ME logs"
        has_profile desktop && dc up -d --force-recreate anki-desktop >/dev/null 2>&1
      else
        touch users.env; chmod 600 users.env
        if users_list | grep -qx "$name"; then
          line="$(grep -nE "^SYNC_USER[0-9]+=\"?$name:" users.env | cut -d: -f1 | head -1)"
          n="$(sed -n "${line}p" users.env | sed -E 's/^SYNC_USER([0-9]+)=.*/\1/')"
          sed -i "${line}d" users.env
        else
          n=2; while grep -q "^SYNC_USER$n=" users.env; do n=$((n + 1)); done
        fi
        echo "SYNC_USER$n=\"$name:$pw\"" >> users.env
        step "Restarting the sync server" dc --progress plain up -d --force-recreate anki-sync || die "couldn't restart: $ME logs sync"
      fi
      ok "$( [ "$sub" = add ] && echo Added || echo "New password for" ) $name"
      [ -n "$gen" ] && kv "Password" "${C_B}${pw}${C_0} ${C_DIM}(shown once)${C_0}"
      true ;;
    remove)
      [ -n "$name" ] || die "usage: $ME users remove NAME"
      [ "$name" != "$ANKI_USER" ] || die "$name is the stack's own account (change its password instead)"
      users_list | grep -qx "$name" || die "no account $name"
      sed -i -E "/^SYNC_USER[0-9]+=\"?$name:/d" users.env
      step "Restarting the sync server" dc --progress plain up -d --force-recreate anki-sync || die "couldn't restart"
      ok "Removed $name ${C_DIM}(their collection stays in data/sync/$name)${C_0}" ;;
    *) die "usage: $ME users [list|add NAME|passwd NAME|remove NAME]" ;;
  esac
}

# --- the desktop -------------------------------------------------------------------

cmd_desktop() {
  require_installed
  case "${1:-}" in
    on)
      set_profile desktop on
      [ -n "$(env_get DESKTOP_PASSWORD)" ] || set_env .env DESKTOP_PASSWORD "$(openssl rand -base64 18 | tr -d '/+=' | cut -c1-20)" force
      load_env; own_data data/desktop
      step "Building the desktop image (takes a few minutes)" dc --progress plain build anki-desktop || die "the build failed"
      step "Starting the desktop" dc --progress plain up -d anki-desktop || die "it didn't start: $ME logs desktop"
      kv "Desktop" "$(local_url "${DESKTOP_BIND:-127.0.0.1:3000}")  ${C_DIM}login ${DESKTOP_USER:-anki} / ${DESKTOP_PASSWORD}${C_0}" ;;
    off)
      dc stop anki-desktop >/dev/null 2>&1; dc rm -f anki-desktop >/dev/null 2>&1
      set_profile desktop off
      ok "Desktop off ${C_DIM}(its data stays in data/desktop)${C_0}" ;;
    ankiconnect)
      case "${2:-}" in on) set_env .env DESKTOP_ANKICONNECT true force ;; off) set_env .env DESKTOP_ANKICONNECT false force ;; *) die "usage: $ME desktop ankiconnect on|off" ;; esac
      load_env
      if has_profile desktop; then step "Restarting the desktop" dc --progress plain up -d --force-recreate anki-desktop || die "couldn't restart"; fi
      ok "AnkiConnect in the desktop: ${2}${C_DIM}$(has_profile desktop || echo " (applies when the desktop is on)")${C_0}" ;;
    "")
      say "Desktop"
      if has_profile desktop; then
        kv "Address" "$(local_url "${DESKTOP_BIND:-127.0.0.1:3000}")"; kv "Login" "${DESKTOP_USER:-anki} / ${DESKTOP_PASSWORD:-}"
        kv "AnkiConnect" "${DESKTOP_ANKICONNECT:-false}"
      else info "Off. Turn it on: $ME desktop on"; fi ;;
    *) die "usage: $ME desktop [on|off|ankiconnect on|off]" ;;
  esac
}

# --- backups ---------------------------------------------------------------------------
# The sync server holds every account's collection: that, .env and users.env
# are the whole install (the worker and the desktop download theirs again).

cmd_backup() {
  require_installed
  local file="${1:-}" ts; ts="$(date +%Y%m%d-%H%M%S)"
  mkdir -p backups && chmod 700 backups
  file="${file:-backups/anki-$ts.tar.gz}"
  say "Backup"
  step "Syncing the worker's last changes" curl -sf -m 300 -X POST "$(ac_url)/admin/sync" -H 'Content-Type: application/json' -d "{\"key\":\"$ANKICONNECT_KEY\"}" || warn "couldn't sync the worker first"
  # a moment's pause in syncing, so the collections are copied whole
  step "Pausing the sync server" dc stop anki-sync
  local rc=0
  step "Packing collections and settings" tar -czf "$file" .env $( [ -f users.env ] && echo users.env ) -C data sync || rc=$?
  step "Starting the sync server" dc --progress plain up -d anki-sync || warn "start it again: $ME restart sync"
  [ "$rc" = 0 ] || die "couldn't write $file"
  chmod 600 "$file"
  ok "Saved $file ${C_DIM}($(du -h "$file" | cut -f1); it holds the passwords and keys: keep it safe)${C_0}"
}

cmd_restore() {
  require_installed
  local file="${1:-}" ans tmp ts; ts="$(date +%Y%m%d-%H%M%S)"
  [ -f "$file" ] || die "usage: $ME restore <backup file>"
  tmp="$(mktemp -d)"; tar -xzf "$file" -C "$tmp" || die "can't read $file"
  [ -d "$tmp/sync" ] && [ -f "$tmp/.env" ] || { rm -rf "$tmp"; die "$file isn't an anki-stack backup"; }
  say "Restore"
  info "Replaces the sync server's collections and the accounts with the backup's. Devices then sync"
  info "against the restored collections (each may be asked to download)."
  ask "Go ahead? [y/N] " ans confirm
  case "$ans" in [yY]*) ;; *) rm -rf "$tmp"; info "Nothing changed."; return ;; esac
  step "Stopping" dc stop
  local k v
  for k in ANKI_USER ANKI_PASSWORD ANKICONNECT_KEY MCP_BEARER_TOKEN; do
    v="$(grep "^$k=" "$tmp/.env" | cut -d= -f2- | sed 's/^"//; s/"$//')"
    [ -n "$v" ] && set_env .env "$k" "$v" force
  done
  [ -f "$tmp/users.env" ] && cp "$tmp/users.env" users.env && chmod 600 users.env
  mv data/sync "data/sync.before-restore-$ts"
  mv "$tmp/sync" data/sync
  # the worker downloads the restored collection; its old copy is kept aside
  [ -d data/worker ] && mv data/worker "data/worker.before-restore-$ts"
  rm -rf "$tmp"; own_data
  ok "Collections restored ${C_DIM}(the previous ones are in data/*.before-restore-$ts)${C_0}"
  load_env
  step "Starting" dc --progress plain up -d --force-recreate || die "it didn't start: $ME logs"
  step "Waiting for the worker" until_ok 60 worker_health || warn "the worker isn't answering yet: $ME logs worker"
  ok "Restored $file"
}

# --- updates ---------------------------------------------------------------------------

cmd_update() {
  require_installed
  say "Updating"
  if [ -d .git ]; then git pull --ff-only || die "git pull failed; resolve that, then run: $ME update"; else warn "Not a git checkout, so nothing to pull"; fi
  exec "$ROOT/anki-stack" --dir "$ROOT" _update ${NONINTERACTIVE:+--yes}
}

# after the pull, in the new version of this script
cmd__update() {
  require_installed
  local img; for img in $(awk '/^ *image: / && !/anki-stack/ {print $2}' compose.yml | sort -u); do
    case "$img" in caddy*) has_profile caddy || continue ;; tailscale/*) has_profile tailscale || continue ;; cloudflare/*) has_profile cloudflare || continue ;; esac
    pull "$img" "$img" || true
  done
  step "Building the Anki image" dc --progress plain build --pull anki-sync || die "the build failed"
  if has_profile desktop; then step "Building the desktop image" dc --progress plain build --pull anki-desktop || die "the desktop build failed"; fi
  step "Restarting on the new version" dc --progress plain up -d --remove-orphans || die "it didn't start: $ME logs"
  step "Waiting for the worker" until_ok 60 worker_health || warn "the worker isn't answering yet: $ME logs worker"
  ok "Updated"
}

cmd_uninstall() {
  load_env
  local ans="" del=""
  say "Uninstall ($ROOT)"
  info "Stops and removes this install's containers. Data stays in data/ unless chosen."
  if [ -z "$NONINTERACTIVE" ]; then ask "Continue? [y/N] " ans; case "$ans" in [yY]*) ;; *) info "Nothing removed."; return ;; esac; fi
  COMPOSE_PROFILES="desktop,caddy,tailscale,cloudflare" dc down --remove-orphans >/dev/null 2>&1 && ok "Removed the containers"
  if [ -n "${TS_SERVE_PORT:-}" ] && command -v tailscale >/dev/null 2>&1; then
    tailscale serve --https="$TS_SERVE_PORT" off >/dev/null 2>&1 && ok "Removed the tailscale serve route (port $TS_SERVE_PORT)"
  fi
  docker image rm "${P}anki-stack:26.9.3" "${P}anki-stack-desktop:26.9.3" >/dev/null 2>&1 || true
  for link in /usr/local/bin/*; do [ -L "$link" ] && [ "$(readlink -f "$link")" = "$ROOT/anki-stack" ] && rm -f "$link" && ok "Removed command $(basename "$link")"; done
  if [ -z "$NONINTERACTIVE" ]; then
    ask "Type 'delete' to delete all data (collections, .env), or Enter to keep it: " del
    [ "$del" = delete ] && rm -rf data .env users.env && ok "Deleted data/ and .env"
  fi
  say "Uninstalled"
}

# --- options and dispatch ----------------------------------------------------------------

ARGS=()
PRESET_PASSWORD=""
while [ $# -gt 0 ]; do
  case "$1" in
    --yes|-y) NONINTERACTIVE=1; PRESET[confirm]=y ;;
    --show-token) PRESET[show-token]=1; ARGS+=("$1") ;;
    --download|--upload) ARGS+=("$1") ;;
    --tail) PRESET[tail]="${2:?}"; shift ;;
    --user|--tz|--https|--domain|--url|--acme-email|--ts-hostname|--desktop|--desktop-ankiconnect|--tailscale-serve|--tailnet-extras)
      k="${1#--}"; PRESET[$k]="${2:?$1 needs a value}"; shift ;;
    --password-env) PRESET_PASSWORD="${!2:?$2 is empty}"; shift ;;
    *) ARGS+=("$1") ;;
  esac
  shift
done
set -- "${ARGS[@]+"${ARGS[@]}"}"
cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  install) cmd_install ;;
  address) cmd_address ;;
  status) cmd_status ;;
  logs) cmd_logs "$@" ;;
  restart) cmd_restart "$@" ;;
  endpoint) cmd_endpoint "$@" ;;
  sync) cmd_sync "$@" ;;
  users) cmd_users "$@" ;;
  desktop) cmd_desktop "$@" ;;
  backup) cmd_backup "$@" ;;
  restore) cmd_restore "$@" ;;
  update) cmd_update ;;
  _update) cmd__update ;;
  uninstall) cmd_uninstall ;;
  link) load_env; cmd_link "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
